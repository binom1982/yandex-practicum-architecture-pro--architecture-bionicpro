# Единая точка входа — BFF
REACT_APP_API_URL=http://localhost:8000 # URL основного API (bionicpro-auth — прокси для аутентификации)
REACT_APP_AUTH_URL=http://localhost:8000 # Сервис аутентификации (bionicpro-auth)
REACT_APP_REPORTS_URL=http://localhost:5001 # Сервис отчётов (bionicpro-reports)

# Keycloak — только для внутренних нужд bionicpro-auth, фронтенд не обращается напрямую
REACT_APP_KEYCLOAK_URL=http://localhost:8080
REACT_APP_KEYCLOAK_REALM=reports-realm
REACT_APP_KEYCLOAK_CLIENT_ID=reports-frontend