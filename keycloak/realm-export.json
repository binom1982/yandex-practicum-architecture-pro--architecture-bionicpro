{
  "id": "reports-realm",
  "realm": "reports-realm",
  "enabled": true,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyInitialCounter": 0,
  "otpPolicyLookAheadWindow": 1,
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10
    }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "id": "ldap-bionicpro-external",
        "name": "bionicpro-external-ldap",
        "providerId": "ldap",
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "id": "username-mapper",
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["uid"],
                "user.model.attribute": ["username"]
              }
            },
            {
              "id": "email-mapper",
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["mail"],
                "user.model.attribute": ["email"]
              }
            },
            {
              "id": "fullname-mapper",
              "name": "fullname",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["cn"],
                "user.model.attribute": ["firstName"]
              }
            },
            {
              "name": "ldap-role-mapper",
              "providerId": "role-ldap-mapper",
              "config": {
                "roles.dn": ["ou=Groups,dc=example,dc=com"],
                "role.name.ldap.attribute": ["cn"],
                "role.object.classes": ["groupOfNames"],
                "membership.ldap.attribute": ["member"],
                "membership.attribute.type": ["DN"],
                "membership.user.ldap.attribute": ["uid"],
                "mode": ["READ_ONLY"],
                "user.roles.retrieve.strategy": ["LOAD_ROLES_BY_MEMBER_ATTRIBUTE"],
                "use.realm.roles.mapping": ["true"],
                "client.id": [""]
              }
            }
          ]
        },
        "config": {
          "enabled": ["true"],
          "priority": ["0"],
          "connectionUrl": ["ldap://openldap:389"],
          "bindDn": ["cn=admin,dc=example,dc=com"],
          "bindCredential": ["adminpassword"],
          "baseDn": ["dc=example,dc=com"],
          "usersDn": ["ou=People,dc=example,dc=com"], 
          "userObjectClasses": ["inetOrgPerson"],
          "usernameLDAPAttribute": ["uid"],
          "rdnLDAPAttribute": ["uid"],
          "uuidLDAPAttribute": ["uid"],
          "userLDAPFilter": ["(objectClass=inetOrgPerson)"],
          "searchScope": ["2"],
          "validatePasswordPolicy": ["false"],
          "trustEmail": ["true"],
          "authType": ["simple"],
          "startTls": ["false"],
          "connectionPooling": ["true"],
          "pagination": ["true"],
          "editMode": ["READ_ONLY"]
        }
      }
    ]
  },
  "roles": {
    "realm": [
      { "name": "user", "description": "Regular user role" },
      { "name": "administrator", "description": "Administrator role" },
      { "name": "prothetic_user", "description": "Prothetic user role with report access" }
    ]
  },
  "users": [
    { "username": "user1", "enabled": true, "email": "user1@example.com", "firstName": "User", "lastName": "One", "credentials": [{ "type": "password", "value": "password123", "temporary": false }], "realmRoles": ["user"], "requiredActions": ["CONFIGURE_TOTP"] },
    { "username": "user2", "enabled": true, "email": "user2@example.com", "firstName": "User", "lastName": "Two", "credentials": [{ "type": "password", "value": "password123", "temporary": false }], "realmRoles": ["user"], "requiredActions": ["CONFIGURE_TOTP"] },
    { "username": "admin1", "enabled": true, "email": "admin1@example.com", "firstName": "Admin", "lastName": "One", "credentials": [{ "type": "password", "value": "admin123", "temporary": false }], "realmRoles": ["administrator"], "requiredActions": ["CONFIGURE_TOTP"] },
    { "username": "prothetic1", "enabled": true, "email": "prothetic1@example.com", "firstName": "Prothetic", "lastName": "One", "credentials": [{ "type": "password", "value": "prothetic123", "temporary": false }], "realmRoles": ["prothetic_user"], "requiredActions": ["CONFIGURE_TOTP"] },
    { "username": "prothetic2", "enabled": true, "email": "prothetic2@example.com", "firstName": "Prothetic", "lastName": "Two", "credentials": [{ "type": "password", "value": "prothetic123", "temporary": false }], "realmRoles": ["prothetic_user"], "requiredActions": ["CONFIGURE_TOTP"] },
    { "username": "prothetic3", "enabled": true, "email": "prothetic3@example.com", "firstName": "Prothetic", "lastName": "Three", "credentials": [{ "type": "password", "value": "prothetic123", "temporary": false }], "realmRoles": ["prothetic_user"], "requiredActions": ["CONFIGURE_TOTP"] }
  ],
  "clients": [
    {
      "clientId": "reports-api",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "oNwoLQdvJAvRcL89SydqCWCe5ry1jMgq",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:8000/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:8000",
        "http://localhost:3000"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8000/*\nhttp://localhost:3000/*",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["openid", "profile", "email", "roles"],
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String",
            "user.attribute": "email"
          }
        }
      ]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-with-otp",
      "description": "Browser flow with mandatory OTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-spnego",
          "requirement": "DISABLED",
          "priority": 20,
          "authenticatorFlow": false
        },
        {
          "flowAlias": "browser-with-otp forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "browser-with-otp forms",
      "description": "Username/password and OTP form",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "browserFlow": "browser-with-otp"
}